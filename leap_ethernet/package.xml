<?xml version="1.0"?>
<!-- ROS package metadata and dependencies for LEAP Ethernet control and the
     UHAS-to-Fetch/LEAP bridge. Install UHAS and NumPy in the active environment. -->
<package format="2">
  <name>leap_ethernet</name>
  <version>0.1.0</version>
  <description>UDP Ethernet control for the LEAP Hand via OpenRB-150</description>
  <maintainer email="kevals2005@gmail.com">Keval Shah</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>actionlib</depend>
  <depend>control_msgs</depend>

  <exec_depend>geometry_msgs</exec_depend>

  <export>
  </export>
</package>
